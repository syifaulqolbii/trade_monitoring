# ==== Database (SQLite via Prisma) ====
DATABASE_URL="file:./dev.db"

# ==== Port host untuk docker compose (bila 3000 terpakai, ganti 3100) ====
APP_PORT=3000

# ==== Login admin (single user) — GANTI sebelum deploy! ====
AUTH_USERNAME="admin"
AUTH_PASSWORD="admin123"

# ==== Session cookie signature — GANTI sebelum deploy! ====
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ==== AES key untuk enkripsi password investor (32 byte hex) — GANTI sebelum deploy! ====
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""