# Konfigurasi nginx untuk Freebuff Monitor (sebelum Certbot).
# Salin ke /etc/nginx/sites-available/freebuff-monitor lalu:
#   sudo ln -s /etc/nginx/sites-available/freebuff-monitor /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Ganti "monitor.domainkamu.com" dengan domain kamu.
# Setelah HTTPS aktif (certbot), blok ini otomatis redirect ke https.

server {
    listen 80;
    listen [::]:80;
    server_name monitor.domainkamu.com;

    # Payload sync dari bridge bisa besar (deal history pertama kali)
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}